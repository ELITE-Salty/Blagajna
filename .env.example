# Kopirajte v .env in izpolnite. Prvi administrator se ustvari ob prvem zagonu (če je baza prazna).
ADMIN_EMAIL=nik.kopi@blu-logistics.si
ADMIN_PASSWORD=takoj-zamenjajte-to-geslo
ADMIN_NAME=Nik Kopi

# Neobvezno: fiksna JWT skrivnost (sicer se samodejno ustvari v data/jwt-secret)
# JWT_SECRET=dolg-nakljucen-niz-vsaj-32-znakov

# Neobvezno: zunanja baza PostgreSQL (npr. v drugem Proxmox CT ali VM).
# Brez te vrstice aplikacija uporablja SQLite datoteko v mapi data/ (nič konfiguracije).
# DATABASE_URL=postgres://blagajna:mocno-geslo@10.0.0.5:5432/blagajna
